# Copy to .env and fill in, or let infra/deploy.sh generate it.
STORAGE_ACCOUNT=stuploadexample001
STORAGE_CONTAINER=public
# Service SAS bound to the stored access policy. Quoted because it contains "&".
STORAGE_SAS_TOKEN='sv=...&si=upload-policy&sr=c&spr=https&sig=...'
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=application/pdf,image/png,image/jpeg
# Clients must send this value in the X-Api-Key header.
UPLOAD_API_KEY=change-me
